# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase.
# Nunca versione o .env.local — ele já está no .gitignore.

# Supabase → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase → Settings → API → Web Push (VAPID) — só necessário se for usar notificações push
VITE_VAPID_PUBLIC_KEY=

# Ativa o módulo de Mesada por Desempenho (uso pessoal, não publicado). "true" ou vazio/ausente.
VITE_ENABLE_MESADA_MODULE=
